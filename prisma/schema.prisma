generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VisibilityMode {
  PUBLIC
  PRIVATE
  STATISTICS
  SHOWCASE
}

// --- Auth.js required models ---

enum CrewVisibility {
  PUBLIC
  PRIVATE
}

enum CrewRole {
  OWNER
  MODERATOR
  MEMBER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- DevNity core models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Auth.js credentials support (only used for email/password signup)
  passwordHash  String?

  // DevNity Identity fields
  username      String    @unique
  handle        String?   @unique
  bio           String?
  country       String?
  trustScore    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  builds       Build[]
  skills       UserSkill[]
  crewMemberships CrewMember[]
  collabs             Collab[]
  collabApplications  CollabApplication[]
  hqMemberships HqMember[]

  posts         Post[]
  postReactions PostReaction[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  conversationParticipations ConversationParticipant[]
  messages                   Message[]

  questions Question[]
  answers   Answer[]

  coursesAuthored Course[]
  enrollments     Enrollment[]

  jobsPosted      Job[]
  jobApplications JobApplication[]

  marketplaceItems MarketplaceItem[]

  eventsHosted    Event[]
  eventAttendance EventAttendee[]

  honors        UserHonor[]
  notifications Notification[]

  startups Startup[]
}

model Skill {
  id   String @id @default(cuid())
  name String @unique

  users UserSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  level   String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Build {
  id          String         @id @default(cuid())
  name        String
  description String?
  visibility  VisibilityMode @default(PUBLIC)
  languages   String[]       @default([])
  readme      String?

  // Stats — "manual" until real git backing exists (source flag protects Trust Score integrity)
  commitsCount      Int    @default(0)
  contributorsCount Int    @default(0)
  linesOfCode       Int    @default(0)
  statsSource       String @default("manual") // "manual" | "git"

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])

  hqLinks HqBuild[]
  posts   Post[]
}

model Crew {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  visibility  CrewVisibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CrewMember[]
}

model CrewMember {
  id       String   @id @default(cuid())
  crewId   String
  userId   String
  role     CrewRole @default(MEMBER)
  joinedAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crewId, userId])
}

enum CollabBudget {
  VOLUNTEER
  REVENUE_SHARE
  PAID
}

enum CollabStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Collab {
  id          String       @id @default(cuid())
  title       String
  description String
  rolesNeeded String[]     @default([])
  budget      CollabBudget @default(VOLUNTEER)
  deadline    DateTime?
  experience  String?
  status      CollabStatus @default(OPEN)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  applications CollabApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollabApplication {
  id      String            @id @default(cuid())
  collabId String
  userId  String
  message String
  status  ApplicationStatus @default(PENDING)

  collab Collab @relation(fields: [collabId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([collabId, userId])
}

enum HqRole {
  OWNER
  ADMIN
  MEMBER
}

model Hq {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  visibility  CrewVisibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   HqMember[]
  buildLinks HqBuild[]
  jobs      Job[]
}

model HqMember {
  id       String @id @default(cuid())
  hqId     String
  userId   String
  role     HqRole @default(MEMBER)
  joinedAt DateTime @default(now())

  hq   Hq   @relation(fields: [hqId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hqId, userId])
}

model HqBuild {
  id      String @id @default(cuid())
  hqId    String
  buildId String
  linkedAt DateTime @default(now())

  hq    Hq    @relation(fields: [hqId], references: [id], onDelete: Cascade)
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([hqId, buildId])
}

model Post {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  buildId   String?
  createdAt DateTime @default(now())

  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  build  Build?  @relation(fields: [buildId], references: [id], onDelete: SetNull)

  reactions PostReaction[]
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// ---------- Messaging ----------
model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ---------- Q&A ----------
model Question {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  tags      String[] @default([])
  createdAt DateTime @default(now())

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  body       String
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ---------- Learning (Dojo) ----------
model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  authorId    String
  createdAt   DateTime @default(now())

  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id       String @id @default(cuid())
  courseId String
  title    String
  content  String
  order    Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  startedAt DateTime @default(now())
  completedLessonIds String[] @default([])

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

// ---------- Careers (Gigs) ----------
model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  remote      Boolean  @default(true)
  hqId        String?
  postedById  String
  createdAt   DateTime @default(now())

  hq          Hq?               @relation(fields: [hqId], references: [id], onDelete: SetNull)
  postedBy    User              @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications JobApplication[]
}

model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  message   String
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
}

// ---------- Marketplace ----------
model MarketplaceItem {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String
  priceCents  Int      @default(0)
  category    String
  createdAt   DateTime @default(now())

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// ---------- Events ----------
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  online      Boolean  @default(true)
  hostId      String
  createdAt   DateTime @default(now())

  host      User               @relation(fields: [hostId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]
}

model EventAttendee {
  id       String   @id @default(cuid())
  eventId  String
  userId   String
  rsvpedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ---------- Honors (achievements) ----------
model Honor {
  id          String  @id @default(cuid())
  name        String  @unique
  description String

  users UserHonor[]
}

model UserHonor {
  id        String   @id @default(cuid())
  userId    String
  honorId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  honor Honor @relation(fields: [honorId], references: [id], onDelete: Cascade)

  @@unique([userId, honorId])
}

// ---------- Pulse (notifications) ----------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Startup Hub ----------
model Startup {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  pitch       String
  founderId   String
  createdAt   DateTime @default(now())

  founder      User               @relation(fields: [founderId], references: [id], onDelete: Cascade)
  cofounderReqs CofounderRequest[]
}

model CofounderRequest {
  id         String @id @default(cuid())
  startupId  String
  roleNeeded String
  message    String

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}