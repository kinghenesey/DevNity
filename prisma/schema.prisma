generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VisibilityMode {
  PUBLIC
  PRIVATE
  STATISTICS
  SHOWCASE
}

// --- Auth.js required models ---

enum CrewVisibility {
  PUBLIC
  PRIVATE
}

enum CrewRole {
  OWNER
  MODERATOR
  MEMBER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- DevNity core models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Auth.js credentials support (only used for email/password signup)
  passwordHash  String?

  // DevNity Identity fields
  username      String    @unique
  handle        String?   @unique
  bio           String?
  country       String?
  trustScore    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  builds       Build[]
  skills       UserSkill[]
  crewMemberships CrewMember[]
  collabs             Collab[]
  collabApplications  CollabApplication[]
  hqMemberships HqMember[]
}

model Skill {
  id   String @id @default(cuid())
  name String @unique

  users UserSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  level   String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Build {
  id          String         @id @default(cuid())
  name        String
  description String?
  visibility  VisibilityMode @default(PUBLIC)
  languages   String[]       @default([])
  readme      String?

  // Stats — "manual" until real git backing exists (source flag protects Trust Score integrity)
  commitsCount      Int    @default(0)
  contributorsCount Int    @default(0)
  linesOfCode       Int    @default(0)
  statsSource       String @default("manual") // "manual" | "git"

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])

  hqLinks HqBuild[]
}

model Crew {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  visibility  CrewVisibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CrewMember[]
}

model CrewMember {
  id       String   @id @default(cuid())
  crewId   String
  userId   String
  role     CrewRole @default(MEMBER)
  joinedAt DateTime @default(now())

  crew Crew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crewId, userId])
}

enum CollabBudget {
  VOLUNTEER
  REVENUE_SHARE
  PAID
}

enum CollabStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Collab {
  id          String       @id @default(cuid())
  title       String
  description String
  rolesNeeded String[]     @default([])
  budget      CollabBudget @default(VOLUNTEER)
  deadline    DateTime?
  experience  String?
  status      CollabStatus @default(OPEN)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  applications CollabApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollabApplication {
  id      String            @id @default(cuid())
  collabId String
  userId  String
  message String
  status  ApplicationStatus @default(PENDING)

  collab Collab @relation(fields: [collabId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([collabId, userId])
}

enum HqRole {
  OWNER
  ADMIN
  MEMBER
}

model Hq {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  visibility  CrewVisibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   HqMember[]
  buildLinks HqBuild[]
}

model HqMember {
  id       String @id @default(cuid())
  hqId     String
  userId   String
  role     HqRole @default(MEMBER)
  joinedAt DateTime @default(now())

  hq   Hq   @relation(fields: [hqId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hqId, userId])
}

model HqBuild {
  id      String @id @default(cuid())
  hqId    String
  buildId String
  linkedAt DateTime @default(now())

  hq    Hq    @relation(fields: [hqId], references: [id], onDelete: Cascade)
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([hqId, buildId])
}